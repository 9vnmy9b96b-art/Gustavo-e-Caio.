:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#eaf3f8;--panel:#fff;--ink:#07202e;--mute:#3f6075;--a:#007c91;--b:#b0107f;--c:#8a6100;--line:rgba(0,124,145,.45);--grid:rgba(0,124,145,.07)}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#04080f;--panel:#07121f;--ink:#dff6ff;--mute:#8fb3c7;--a:#00e5ff;--b:#ff2bd6;--c:#ffd23f;--line:rgba(0,229,255,.35);--grid:rgba(0,229,255,.06)}}
:root[data-theme="dark"]{--bg:#04080f;--panel:#07121f;--ink:#dff6ff;--mute:#8fb3c7;--a:#00e5ff;--b:#ff2bd6;--c:#ffd23f;--line:rgba(0,229,255,.35);--grid:rgba(0,229,255,.06)}
*,*::before,*::after{box-sizing:border-box}
html,body{height:100%;margin:0}
body{display:flex;flex-direction:column;background:var(--bg);color:var(--ink);font:16px/1.65 "IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;overflow:hidden;
background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:28px 28px}
h1,h2,.big{font-family:Orbitron,"IBM Plex Mono",ui-monospace,sans-serif;font-weight:700}
.hud{flex:none;display:flex;justify-content:space-between;align-items:center;padding:12px 18px;border-bottom:1px solid var(--line);font-size:13px;color:var(--mute)}
.hud b{color:var(--a);font-weight:600}
.deck{flex:1;min-height:0;display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain}
.deck::-webkit-scrollbar{display:none}
.s{flex:0 0 100%;scroll-snap-align:start;overflow-y:auto;padding:16px}
.in{position:relative;min-height:100%;max-width:560px;margin:0 auto;display:flex;flex-direction:column;justify-content:center;padding:30px 24px;background:color-mix(in srgb,var(--panel) 88%,transparent);border:1px solid var(--line)}
.in::before,.in::after{content:"";position:absolute;width:22px;height:22px;border:3px solid var(--a)}
.in::before{top:-2px;left:-2px;border-right:0;border-bottom:0}.in::after{bottom:-2px;right:-2px;border-left:0;border-top:0}
.tag{color:var(--b);font-weight:600;font-size:14px;margin:0 0 8px}
.tag::before{content:"> "}
h1{font-size:clamp(30px,9.5vw,46px);line-height:1.1;margin:0 0 16px;color:var(--a);text-shadow:0 0 18px color-mix(in srgb,var(--a) 55%,transparent)}
h2{font-size:clamp(23px,7vw,31px);line-height:1.15;margin:0 0 18px;color:var(--a)}
p{margin:0 0 14px}.mute{color:var(--mute)}
.big{font-size:clamp(70px,24vw,120px);line-height:1;color:var(--b);margin:0 0 4px;text-shadow:0 0 22px color-mix(in srgb,var(--b) 50%,transparent)}
.lead{color:var(--c);font-weight:600;font-size:19px;line-height:1.4}
.badge{align-self:flex-start;border:1px solid var(--c);color:var(--c);padding:4px 12px;font-size:14px;margin:0 0 14px}
.badge::before{content:"● ";}
.grp{margin-top:22px;border:1px solid var(--line);padding:14px 16px}
.grp b{display:block;color:var(--ink);font:700 18px Orbitron,monospace}.grp span{color:var(--c)}
.cmp{display:grid;gap:12px;margin-top:8px}
.cmp div{border:1px solid var(--line);padding:14px}.cmp b{display:block;color:var(--mute);font-weight:600;margin-bottom:4px}
.cmp .hi{border-color:var(--a)}.cmp .hi b{color:var(--a)}
.quote{border-left:4px solid var(--b);padding-left:16px;font-size:18px;line-height:1.6}
img,video{display:block;width:auto;max-width:100%;max-height:44vh;margin:6px auto 0;background:#000;border:1px solid var(--a);box-shadow:0 0 18px color-mix(in srgb,var(--a) 35%,transparent)}
.vid video{max-height:60vh}
.bar{flex:none;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 16px;border-top:1px solid var(--line)}
.bar button{width:46px;height:46px;border:1px solid var(--a);background:transparent;color:var(--a);font:600 22px "IBM Plex Mono",monospace;cursor:pointer}
.bar button:active{background:var(--a);color:var(--bg)}
.seg{flex:1;display:flex;gap:4px}.seg i{flex:1;height:5px;background:var(--line)}.seg i.on{background:var(--a);box-shadow:0 0 8px var(--a)}